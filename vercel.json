{
  "buildCommand": "npm install --prefix react-knitting-studio && npm run build --prefix react-knitting-studio",
  "outputDirectory": "react-knitting-studio/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}